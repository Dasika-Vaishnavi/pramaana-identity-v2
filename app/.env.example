# World ID 4.0 — copy to app/.env and fill in real values to enable LIVE mode.
# app/.env is gitignored (the repo's root .gitignore ignores `.env`). With the
# placeholder values below (or no .env at all) the demo runs in STUB mode, which
# still ENFORCES the gate shape: a claim with no proof-of-human is rejected (403)
# and the offline demo / CI stay green. Filling in a real APP_ID flips it to
# LIVE mode, where proofs are verified against World's v4 API in the backend.

# From https://developer.worldcoin.org → your app. Leave as the placeholder to
# stay in stub mode.
APP_ID=app_PLACEHOLDER_replace_in_dotenv

# The base action you configured for this app. The demo appends ":<service>"
# per airdrop so each service has its own World ID nullifier namespace (keeps
# the two airdrops cross-service unlinkable on the World side too).
ACTION_ID=pramaana-airdrop

# Relying-party id used in the v4 verify URL: /api/v4/verify/{RP_ID}.
# Defaults to APP_ID if unset.
RP_ID=app_PLACEHOLDER_replace_in_dotenv

# RP Ed25519 signing key — required for LIVE mode only (used to sign the IDKit
# request via @worldcoin/idkit-core/signing). Keep secret; never commit.
RP_SIGNING_KEY=

# Optional explicit override: "live" or "stub". Unset → inferred from APP_ID.
# WORLDID_MODE=stub
