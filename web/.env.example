# Pramaana web — environment template.
# Copy this file to web/.env.local and fill in real values.
# Do NOT commit .env.local (it is gitignored).

# Mainnet RPC used by the ENS resolver (ethers v6 JsonRpcProvider).
# Public node, no API key required.
VITE_ENS_RPC_URL=https://ethereum-rpc.publicnode.com

# V3 backend base URL for PramaanaClient. OPTIONAL.
# Leave blank to use the Vite dev proxy (/api -> http://127.0.0.1:8080,
# see web/vite.config.ts). Set e.g. http://127.0.0.1:8080 to bypass the proxy.
# ENS resolution does NOT depend on this value.
VITE_API_BASE=
